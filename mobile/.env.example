# The app never holds Google/Azure keys. Cloud OCR (Google Vision) and Khmer
# neural TTS (Azure) go through the website's serverless functions (api/ocr.js,
# api/tts.js), which keep the keys server-side.
#
# Set this to the deployed site to enable them. Leave it empty to use
# on-device Tesseract OCR and the phone's own voices.
EXPO_PUBLIC_API_BASE_URL=https://<your-app>.vercel.app
