# ─── Server-side keys (Vercel → Project Settings → Environment Variables) ───
# Read only by the serverless functions in api/. They must NOT start with
# VITE_, or Vite would bake them into the public website bundle.

GOOGLE_VISION_API_KEY=
# Optional, defaults to https://vision.googleapis.com/v1/images:annotate
GOOGLE_VISION_ENDPOINT=

AZURE_TTS_API_KEY=
# Optional, defaults to https://southeastasia.tts.speech.microsoft.com/cognitiveservices/v1
AZURE_TTS_ENDPOINT=

# ─── Local development only (.env) ───
# `npm run dev` doesn't run the api/ functions. Point this at your deployed
# site to use its OCR/TTS locally; leave it empty to use on-device Tesseract
# and the browser's own voices.
VITE_API_PROXY=
